{
  "name": "tablemates",
  "private": true,
  "packageManager": "pnpm@10.34.7",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @tablemates/api dev",
    "dev:mobile": "pnpm --filter @tablemates/mobile start",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @tablemates/api db:migrate",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test"
  }
}
