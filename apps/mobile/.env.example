# Copy to apps/mobile/.env. EXPO_PUBLIC_* values are bundled into the app, so use
# a browser key restricted by HTTP referrer (localhost:8081 and your domain).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (falls back to DEMO_MAP_ID for development).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Only needed for Android builds.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: point the app at a different API.
# EXPO_PUBLIC_API_URL=http://localhost:4000
