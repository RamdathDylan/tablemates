# Template for apps/mobile/.env. Copy it there and fill in the values. Never commit the copy.
# EXPO_PUBLIC_* values are bundled into the app and visible to anyone who has it,
# so use keys restricted by HTTP referrer (web) or app signature (Android).
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
# Map ID from Google Cloud > Map Management (falls back to DEMO_MAP_ID in development).
EXPO_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Maps SDK for Android key. Only needed for Android builds.
GOOGLE_MAPS_ANDROID_API_KEY=
# Optional: point the app at a different API (defaults to the Expo dev server's LAN address).
# EXPO_PUBLIC_API_URL=http://localhost:4000
