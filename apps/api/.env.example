# Template for apps/api/.env. Copy it there and fill in the values. Never commit the copy.
DATABASE_URL=postgres://tablemates:tablemates@localhost:5433/tablemates
TEST_DATABASE_URL=postgres://tablemates:tablemates@localhost:5433/tablemates_test
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_PLACES_API_KEY=
PORT=4000
# Comma-separated origins allowed to call the API from a browser (Expo web dev server)
CORS_ORIGINS=http://localhost:8081
# Proxies trusted to report the client address (X-Forwarded-For), used for per-IP
# rate limits. "false" trusts none (default). Behind a load balancer use a hop
# count (e.g. 1) or the proxy addresses/CIDRs. Never "true" on a directly exposed API.
TRUST_PROXY=false
# Optional: share rate-limit counters across API instances (e.g. redis://localhost:6379).
REDIS_URL=
# Email: "mailpit" (local inbox at http://localhost:8025) or "resend"
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
# Until you verify a domain in Resend, use onboarding@resend.dev (delivers only to your own address)
MAIL_FROM=TableMates <onboarding@resend.dev>
# Optional: only if "enhanced push security" is on for your Expo project
EXPO_ACCESS_TOKEN=
# Photo storage (S3 API). Local RustFS from docker-compose; for Cloudflare R2 use
# https://<account-id>.r2.cloudflarestorage.com and an R2 API token's keys.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=tablemates-photos
S3_ACCESS_KEY_ID=tablemates
S3_SECRET_ACCESS_KEY=tablemates-dev
S3_REGION=auto
