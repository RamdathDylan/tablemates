# apps/api reads these. Copy to apps/api/.env
DATABASE_URL=postgres://tablemates:tablemates@localhost:5433/tablemates
TEST_DATABASE_URL=postgres://tablemates:tablemates@localhost:5433/tablemates_test
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_PLACES_API_KEY=
PORT=4000
# Comma-separated origins allowed to call the API from a browser (Expo web dev server)
CORS_ORIGINS=http://localhost:8081
# Email: "mailpit" (local inbox at http://localhost:8025) or "resend"
MAIL_PROVIDER=mailpit
MAILPIT_URL=http://localhost:8025
RESEND_API_KEY=
# Until you verify a domain in Resend, use onboarding@resend.dev (delivers only to your own address)
MAIL_FROM=TableMates <onboarding@resend.dev>
